# Copy to .env; never commit .env or paste passwords into chat.
# Public hostname must resolve to your server IP. A free DDNS hostname may work.
BAGER_DOMAIN=example.your-domain.invalid
# Generate each password independently with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
BAGER_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET
