# Copy to .env and chmod 600 .env. NEVER commit .env.
# Use a real DNS hostname pointing to your server's public IP.
SITE_DOMAIN=your-free-dns-hostname.example
# Generate separate long random values; avoid @ : / ? # % in POSTGRES_PASSWORD (used in DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
BAGER_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
