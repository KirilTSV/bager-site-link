# Required for first local dispatcher login. Replace with a long unique password.
BAGER_ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-RANDOM-PASSWORD
# SQLite local pilot. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./bager_site_link.db
SESSION_HOURS=14
# Set COOKIE_SECURE=1 only behind HTTPS.
COOKIE_SECURE=0
